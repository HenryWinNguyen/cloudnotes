generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Note {
  id        String   @id @default(uuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cells     Cell[]
}

model Cell {
  id        String   @id @default(uuid())
  noteId    String
  order     Int
  type      CellType
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@unique([noteId, order])
}

enum CellType {
  markdown
  code
}
